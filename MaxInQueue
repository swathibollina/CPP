#include <bits/stdc++.h>
using namespace std;

int main() 
{
	// Find the maximum element in a queue.
	queue<int> q;
	int max=0,t=0;
	q.push(11);
	q.push(3);
	q.push(50);
	q.push(18);
	q.push(13);
	q.push(12);
	while(!q.empty())
	{
	    t=q.front();
	    if(t>max)
	    max=t;
	    q.pop();
	}
	cout<<max<<endl;
}
